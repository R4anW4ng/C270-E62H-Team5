<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Vendor Fulfillment Dashboard</title>
    <link rel="stylesheet" href="/css/vendor.css" />
  </head>
  <body>
    <main class="dashboard">
      <header class="page-header">
        <h1>Vendor Fulfillment Dashboard</h1>
        <p>Incoming orders grouped by item type for efficient kitchen preparation.</p>
      </header>

      <% if (!hasOrders) { %>
        <div class="empty-state">No incoming orders at the moment.</div>
      <% } else { %>
        <% Object.entries(groupedOrders).forEach(([type, items]) => { %>
          <% if (items.length > 0) { %>
            <section class="item-group">
              <h2><%= type.charAt(0).toUpperCase() + type.slice(1) %></h2>
              <div class="orders-list">
                <% items.forEach((order) => { %>
                  <article class="order-card">
                    <div class="field">
                      <span class="label">Order ID</span>
                      <p>#<%= order.order_id %></p>
                    </div>
                    <div class="field">
                      <span class="label">Item Name</span>
                      <p><%= order.item_name %></p>
                    </div>
                    <div class="field">
                      <span class="label">Quantity</span>
                      <p><%= order.quantity %></p>
                    </div>
                    <div class="field">
                      <span class="label">Status</span>
                      <p><%= order.status %></p>
                    </div>
                  </article>
                <% }); %>
              </div>
            </section>
          <% } %>
        <% }); %>
      <% } %>
    </main>
  </body>
</html>
